#!/usr/bin/env bash
# Runs the reference implementation on a single source file.
#
# This is the entrypoint run_tests.py invokes, and it honours the same contract
# the course asks groups for: stdout carries program output, stderr carries
# diagnostics, and the exit code says how it went.

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

binary=bin/cmsc124-ref
if [ ! -x "$binary" ] && [ -x "$binary.exe" ]; then
  binary="$binary.exe"
fi

if [ ! -x "$binary" ]; then
  echo "ERROR: the reference is not built. Run ./build.sh first." >&2
  exit 1
fi

exec "./$binary" "$@"
