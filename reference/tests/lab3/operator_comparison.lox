1 < 2;    // expect: true
2 < 2;    // expect: false
2 < 1;    // expect: false

1 <= 2;    // expect: true
2 <= 2;    // expect: true
2 <= 1;    // expect: false

1 > 2;    // expect: false
2 > 2;    // expect: false
2 > 1;    // expect: true

1 >= 2;    // expect: false
2 >= 2;    // expect: true
2 >= 1;    // expect: true

// Zero and negative zero compare the same.
0 < -0; // expect: false
-0 < 0; // expect: false
0 > -0; // expect: false
-0 > 0; // expect: false
0 <= -0; // expect: true
-0 <= 0; // expect: true
0 >= -0; // expect: true
-0 >= 0; // expect: true
